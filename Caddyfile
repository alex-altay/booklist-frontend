{
	# global options
	admin off # theres no need for the admin api in railway's environment
	persist_config off # storage isn't persistent anyway
	auto_https off # railway handles https for us, this would cause issues if left enabled
	log {
		# runtime logs
		format json # set runtime log format to json mode 
	}
	servers {
		# server options
		trusted_proxies static private_ranges # trust railway's proxy
	}
}

:{$PORT} {
	# site block, listens on the $PORT environment variable, automatically assigned by railway
	log {
		# access logs
		format json # set access log format to json mode
	}

	# security headers
	header {
		# Always safe: no sniffing, no framing, no referrer leakage to other origins
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin

		# The point of this policy is connect-src: even if a compromised dependency runs inside our
		# origin, it cannot ship the access token anywhere except our own API. That is the same
		# protection an httpOnly cookie would buy, without a backend change.
		#
		# API_ORIGIN must be set per environment (scheme + host, no trailing slash), e.g.
		# https://api.example.com — it has no default on purpose, so the two environments cannot
		# silently inherit each other's backend. If it is unset the directive collapses to 'self'
		# and every API call is blocked.
		#
		# Two things this policy deliberately does NOT allow, both verified in Report-Only first:
		#   'unsafe-eval'  — zod JIT-compiles validators via new Function. Disabled instead through
		#                    z.config({ jitless: true }) in src/schemas/zod.ts, which must be
		#                    evaluated before any schema is created.
		#   external fonts — Inter is self-hosted via @fontsource-variable/inter, so no third-party
		#                    host appears here at all.
		# style-src needs 'unsafe-inline' because Tailwind and Vue :style bindings emit inline styles.
		#
		# If this ever needs debugging, rename the field back to Content-Security-Policy-Report-Only:
		# violations are then reported to the console without anything being blocked.
		Content-Security-Policy "default-src 'self'; connect-src 'self' {$API_ORIGIN}; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

		# don't advertise the server
		-Server
	}

	# health check for railway
	respond /health 200

	# serve from the 'dist' folder (Vite builds into the 'dist' folder)
	root * dist

	# enable gzipping responses
	encode gzip

	# serve files from 'dist'
	file_server

	# if path doesn't exist, redirect it to 'index.html' for client side routing
	try_files {path} /index.html
}
