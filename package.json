    "@vueuse/core": "^14.0.0",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.548.0",
    "pinia": "^3.0.1",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.13.13",
    "@vitejs/plugin-vue": "^5.0.5",
